# ---- Cloud mode (Google AI Studio) ----
# Paste your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Copy the EXACT Gemma model ID shown in AI Studio and paste it here.
# (The code default is only a guess — always set this to the real ID.)
GEMMA_MODEL=gemma-3-27b-it

# ---- Optional: fully-local mode ----
# Set USE_OLLAMA=1 (and run `ollama pull gemma3`) to ignore the cloud key
USE_OLLAMA=0
OLLAMA_MODEL=gemma3
OLLAMA_URL=http://localhost:11434/api/chat

# ---- Server ----
HOST=0.0.0.0
PORT=5000
